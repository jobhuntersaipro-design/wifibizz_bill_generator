# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# bill generator output
bill_generator/output/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# playwright
.playwright-mcp/
*.png

# scraper (separate Python project — contains dealer credentials, session
# state, and Google service-account keys; managed/deployed outside this repo)
# /scraper/

*.html
*.pdf

# …except the scraper's test fixtures. They are stand-ins for portal pages, and
# the scroll/capture tests are meaningless without them — the blanket *.html
# above would drop them from a fresh clone and leave the suite failing.
!scraper/tests/fixture_*.html

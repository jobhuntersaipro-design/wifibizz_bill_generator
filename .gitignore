# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# …at any depth: `npx vitest` run from scraper/ leaves a node_modules/.vite
# cache there, which the root-anchored rule above does not cover.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# bill generator output
bill_generator/output/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# playwright
.playwright-mcp/
*.png
# The playwright rule above is blanket — shipped UI assets need the explicit
# negation, or the deploy 404s while the local build passes.
!public/animations/*.png
!public/icon-*.png
!src/app/icon.png
!src/app/apple-icon.png

# scraper (separate Python project — contains dealer credentials, session
# state, and Google service-account keys; managed/deployed outside this repo)
# /scraper/

*.html
*.pdf

# …except the scraper's test fixtures. They are stand-ins for portal pages, and
# the scroll/capture tests are meaningless without them — the blanket *.html
# above would drop them from a fresh clone and leave the suite failing.
!scraper/tests/fixtures/
!scraper/tests/fixtures/*.html

# …and except the bill templates. Every generator reads one at runtime, so the
# blanket *.pdf above would leave a fresh clone (and any deploy built from one)
# throwing on a missing file. The four older templates predate that rule and are
# already tracked; this keeps the next one from being dropped silently.
!bill_generator/template/
!bill_generator/template/*.pdf

# Chris’s 13-page TA sample if it lands under assets/ instead of the bill
# generator template folder. The blanket *.pdf above would otherwise drop it.
!assets/
!assets/*.pdf
!src/lib/bill-generator/templates/
!src/lib/bill-generator/templates/*.pdf

# Seeding input for scripts/seed-orders.ts — holds real customer addresses.
addresses.txt

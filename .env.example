# Copy to .env.local and fill in real values. .env.local is gitignored and never committed.
# Production secrets belong ONLY in Vercel's Environment Variables dashboard, not in a local file.

# Google Sheets service account (JSON, single line)
GOOGLE_SERVICE_ACCOUNT_JSON=

GOOGLE_MAPS_API_KEY=

# Cloudflare R2 (bill PDF storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Admin panel login (separate from NextAuth)
BIZZFLOW_ADMIN_USERNAME=
BIZZFLOW_ADMIN_PWD=

# NextAuth
AUTH_SECRET=

# Neon PostgreSQL — use your Neon "development" branch connection string locally,
# never the production branch.
DATABASE_URL=

# Upstash Redis (auth rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Unifi eSales dealer portal — Flask scraper service the Next.js app calls over HTTP.
# Both processes read this file: Next.js loads it natively; the Flask service
# loads it via python-dotenv (find_dotenv walks up from scraper/). So the shared
# secret below lives in ONE place.
SCRAPER_API_URL=http://localhost:5000
# Public droplet URL the ADMIN'S BROWSER connects to for the live view stream
# (server-side calls use SCRAPER_API_URL). https://scraper.bizzflow.top in production.
NEXT_PUBLIC_SCRAPER_API_URL=http://localhost:5000
# Origin allowed to open the live view stream (droplet side, CORS on that one route).
LIVE_VIEW_ORIGIN=http://localhost:3000
ORDER_ENTRY_API_TOKEN=

# Dealer portal credentials — FOR LOCAL TESTING ONLY (test_dealer_login.py).
# The real per-user web flow collects these from each user in the UI and never
# stores them; these are just so you don't retype them while testing.
DEALER_STAFF_CODE=
DEALER_PASSWORD=

# Auto-read dealer-login OTP from Gmail (see
# context/features/gmail-otp-auto-read-spec.md). Attempted for every
# Email-channel login; only actually succeeds when the OTP lands in the
# mailbox this server has Gmail API access to (config/gmail_credentials.json +
# config/gmail_token.json in scraper/) — otherwise it times out and the UI
# falls back to the manual OTP form.
GMAIL_OTP_SENDER_FILTER=@unifi.com.my
# 210 gives ~150s of real search time (the reader backdates its start by 60s
# internally) — live-tested Unifi-send -> Gmail-forward latency was ~150s.
GMAIL_OTP_TIMEOUT_SECONDS=210

# Shared WifiBizz crawl account (all enabled users crawl with this).
WIFIBIZZ_BASE_URL=https://wifibizz.com
WIFIBIZZ_CRAWL_EMAIL=
WIFIBIZZ_CRAWL_PASSWORD=

ORDER_ENTRY_DO_PAY=false

# ── Order-entry capture trail ────────────────────────────────────────────────
# A submit photographs each of its detail screens into R2 under
# `order-screenshots/<userId>/<orderId>/`.
#
# Scraper (droplet) side:
#   OE_CAPTURE=false        disable all capture without a redeploy
#   OE_CAPTURE_SLOTS=page1,broadband
#                           narrow to specific slots (empty = every slot)
#
# App side: how long a frame survives, shown as a countdown beside it. LEAVE
# UNSET until the R2 lifecycle rule below actually exists — an unset value
# renders no countdown at all, which is better than a UI asserting a retention
# policy nobody applied. Set it to 90 once the rule is live:
#
#   R2 -> bucket -> Settings -> Object lifecycle rules -> Add rule
#     name   : expire-order-screenshots
#     prefix : order-screenshots/          (NOT orders/ — that holds customer
#                                           ID copies and bills, which must not
#                                           expire)
#     action : Delete objects, 90 days after upload
NEXT_PUBLIC_CAPTURE_RETENTION_DAYS=

# ── Order notifications (Resend) + server-side batch submit ──────────────────
# A submit's result, and one summary per batch, are emailed to the address each
# user sets in Settings (falling back to their login email). ALL sending happens
# on Vercel — the droplet never holds the key and never renders a template; it
# only reports completion over the webhook below.
#
# Leave RESEND_API_KEY unset locally and sending no-ops with a logged warning,
# so dev works without mail credentials.
#
# ⚠ Resend only delivers to the account owner's own address until a sending
#   domain is verified (add the SPF + DKIM records Resend shows, then wait for
#   "verified"). Until then, every other recipient is silently undeliverable.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=            # e.g. BizzFlow <notifications@bizzflow.top>

# Absolute base URL used for the "open this order" links in emails. Falls back
# to https://$VERCEL_URL; when neither is set the emails simply omit the link
# rather than emitting one that 404s.
BIZZFLOW_APP_URL=

# Shared secret the droplet presents to POST /api/hooks/scraper. Set on BOTH
# Vercel and the droplet — they must match. Unset on Vercel, the route refuses
# every request (503) rather than running unauthenticated.
SCRAPER_WEBHOOK_SECRET=

# Droplet only: where to POST completion events.
# e.g. https://<app>.vercel.app/api/hooks/scraper
BIZZFLOW_WEBHOOK_URL=

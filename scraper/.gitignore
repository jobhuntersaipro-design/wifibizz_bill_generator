*.enc
*.key
*.session
.env
.env.*
service_account.json
gmail_credentials.json
gmail_token.json
authorized_users.json

# ── Runtime / generated artifacts ──
logs/
jobs/
outputs/
inspect_dumps/

# ── Python ──
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# ── OS ──
.DS_Store

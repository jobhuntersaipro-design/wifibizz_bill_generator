# Droplet / local state. None of this is tracked today — this file makes that
# deliberate rather than accidental. Under the git deploy these directories sit
# *inside* the working tree on the droplet and hold the API token, every dealer
# session and the Gmail OTP credentials. A stray `git add -A` must never take
# them, and `git status` must stay clean so deploy.sh's drift check is meaningful.
.env
.env.*
!.env.example
.last-deploy

sessions/
config/
logs/
jobs/
outputs/

# Local tooling
venv/
__pycache__/
*.pyc
.pytest_cache/

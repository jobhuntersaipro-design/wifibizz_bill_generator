generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String               @id @default(cuid())
  name              String?
  email             String?              @unique
  password          String?
  passwordRaw       String?              @map("password_raw")
  notes             String?
  caseLimit         Int                  @default(10) @map("case_limit")
  orderEntryEnabled Boolean              @default(false) @map("order_entry_enabled")
  isSuperAdmin      Boolean              @default(false) @map("is_super_admin")
  // Where submit-result and batch-summary emails go. Null falls back to `email`
  // (the login address) at send time — kept as a separate, nullable column so a
  // blank field means "use my login email" rather than silently copying it and
  // then drifting when the login address changes.
  notificationEmail String?              @map("notification_email")
  wifibizzUser      WifibizzUser?
  dealerAccount     DealerAccount?
  orders            Order[]
  caseUsageLogs     CaseUsageLog[]
  limitChangeLogs   CaseLimitChangeLog[]
  batchRuns         BatchRun[]
  passwordResets    PasswordResetToken[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

// A broadband order an agent keys in BizzFlow to be submitted to the Unifi eSales
// dealer portal. Phase 1 captures customer + address + package + documents;
// install/contact/billing come later. `orderId` is written back from the portal.
model Order {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Customer
  idType      String  @map("id_type")
  idNumber    String  @map("id_number")
  idExpiry    String? @map("id_expiry") // dd-mm-yyyy (passport/foreigner)
  fullName    String  @map("full_name")
  gender      String?
  birthday    String? // dd-mm-yyyy (auto-derived for MyKad-like IDs)
  race        String?
  nationality String? @default("Malaysia")

  // Contact
  mobilePrefix String? @default("60") @map("mobile_prefix") // country code
  mobile       String? // number after the country code
  email        String?

  // Service address — picked from the portal's QryNIGAddress search
  street          String?
  postcode        String?
  city            String?
  state           String?
  country         String? @default("Malaysia") // always Malaysia for the portal
  addressId       String? @map("address_id") // resourceInstId (select "By Address Id")
  addressFull     String? @map("address_full") // concatAddress
  serviceCategory String? @map("service_category") // addrServiceCategory (e.g. FTTH)

  // Package (Main Offer)
  offerCategory String? @map("offer_category")
  offerName     String? @map("offer_name")

  // Device / add-on (VAS) — chosen for "with device" bundles; picked after the
  // package. deviceCode is the portal VAS numeric id (js-vas-name-container id).
  deviceCode String? @map("device_code")
  deviceName String? @map("device_name")

  remarks String? // additional remarks / customer remarks

  // Documents — array of { type, url, filename } (up to 10 files)
  documents Json?

  // How many hours ahead of submit time the earliest bookable installation slot
  // must be. Set by the agent on the order form. NULL means "not set" — orders
  // written before this column existed, and anything the bulk script writes —
  // and resolves to DEFAULT_LEAD_HOURS when the job payload is built.
  appointmentLeadHours Int? @map("appointment_lead_hours")

  // Submission result
  status       String  @default("draft") // draft | submitting | submitted | failed
  orderId      String? @map("order_id") // dealer portal order number
  errorMessage String? @map("error_message")
  // Stable classification of the LAST failure, from the scraper's oe_errors
  // vocabulary (e.g. device_out_of_stock). Kept beside the free-text message
  // rather than parsed back out of it: the message is the portal's wording and
  // changes without notice, while the UI needs to branch on what went wrong to
  // tell the agent which field to fix.
  errorCode    String? @map("error_code")

  // Live submit progress. The scraper reports a stage key per portal milestone;
  // the browser polls for it rather than holding a long request open.
  // jobId is what lets a poll AFTER the submitting tab is gone still reconcile
  // the run — without it, a closed tab strands the order in `submitting`.
  // Automatic retries spent on the CURRENT run of this order, capped at
  // MAX_AUTO_RETRIES. Separate from `attempt`, which counts every submit
  // including the ones a human started — reusing that would let a draft an
  // agent resubmitted by hand arrive with its automatic budget already spent.
  // Reset to 0 whenever a person presses Submit or Resubmit.
  autoRetries Int @default(0) @map("auto_retries")

  // Set when a retry was decided but the droplet was busy with another job (its
  // HTTP 409 lock), cleared when the retry starts. Vercel cannot sleep between
  // requests, so "shortly" has to be a row somebody sweeps.
  autoRetryAt DateTime? @map("auto_retry_at")

  // Whose dealer session ran the last submit. A submit runs under the session of
  // whoever pressed the button — a superadmin submits another agent's draft
  // under their OWN session — and an automatic retry has none to read.
  lastSubmitUserId String? @map("last_submit_user_id")

  jobId   String?   @map("job_id") // Flask job id for the in-flight run
  stage   String? // last stage key seen (e.g. checking_address)
  stageAt DateTime? @map("stage_at") // when `stage` last changed — staleness check

  // R2 key of the LATEST attempt's page-1 screenshot, so a collapsed row can
  // show that evidence exists without loading history. A submit captures one
  // frame per detail screen; every key lives on OrderStatusEvent (stages
  // `capture_<slot>`) — that is what the detail panel reads, since a retried
  // order has its own set of frames per attempt. Page 1 is the one kept here
  // because it is the most representative single image of a submit.
  screenshotUrl String? @map("screenshot_url")

  // When a signed-in eye first saw this order's terminal outcome — NULL on a
  // finished order means "unseen", which is what the Orders-tab badge counts.
  // Stamped by the progress poll (the watcher's own browser delivering the
  // terminal state IS the seeing), the detail page, or a dismiss; cleared by
  // startSubmitRun so every new run produces a fresh outcome.
  outcomeSeenAt DateTime? @map("outcome_seen_at")

  // Soft delete. An agent's Delete sets this rather than destroying the row:
  // the order and its whole status history survive so admin oversight can see
  // what was deleted, while the agent's own list stops showing it.
  //
  // Every agent-facing query filters on it through the shared ACTIVE_ORDER
  // fragment; admin queries deliberately do not, and are the only place that
  // sees deleted rows.
  deletedAt DateTime? @map("deleted_at")

  // Short human reference (ORD-0042), assigned at creation. The portal's own
  // order number only exists after a successful run, and not at all for a draft,
  // so agents need something quotable before then.
  reference String? @unique

  // Which submit run the events below belong to. Bumped by each startSubmit so
  // the history can show attempt 1 vs attempt 3 rather than one flat stream.
  attempt Int @default(0)

  // When the single-submit result email for this order was sent. The exactly-
  // once guard: the webhook retries up to 3 times, and the handler claims this
  // with a conditional update (WHERE notified_at IS NULL) BEFORE sending, so a
  // retry that arrives after a success can never send a second email.
  //
  // Deliberately not reset by a resubmit: a resubmit that reaches a terminal
  // state clears it explicitly at start, so each attempt gets exactly one email.
  notifiedAt DateTime? @map("notified_at")

  // Installation appointment, read out of the e-RF PDF the portal issues after
  // Pay ("Installation Appointment Date : 2026-08-20 09:30-12:00"), stored
  // VERBATIM as the document prints it. Not a DateTime: the value is a date
  // plus a two-ended arrival WINDOW, and collapsing that to an instant would
  // invent a precision the appointment does not have.
  //
  // Filled lazily the first time a submitted order is listed, because the only
  // record of the booked slot for orders placed before this existed is the PDF
  // itself — the scraper picks the slot and then discards it.
  installationDate      String?   @map("installation_date")
  // When the e-RF was last read for the field above. Null-vs-set is what
  // separates "never looked" from "looked, and this order has no appointment"
  // (a self-install e-RF prints no such line). Without it, every list load
  // re-downloads the PDF of every order that legitimately has no date.
  installationCheckedAt DateTime? @map("installation_checked_at")

  statusEvents OrderStatusEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  // Every agent-facing list filters on this; admin oversight is the only
  // reader that does not.
  @@index([deletedAt])
  @@map("orders")
}

/**
 * One server-side batch submit.
 * The batch loop lives on the droplet, not in the browser, so a closed tab
 * cannot strand the remaining orders. This row is BizzFlow's side of that run:
 * what was sent, in what order, what came back, and whether the one summary
 * email has been sent yet.
 */
model BatchRun {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ordered array of Order.id, oldest-created FIRST. This is the run order the
  // droplet was given and preserves; the UI reads progress against it.
  orderIds Json @map("order_ids")

  // Per-order outcome once the run finishes:
  // [{ orderId, reference, fullName, outcome, errorCode?, portalOrderNo? }]
  // Denormalised on purpose — the summary email must describe the run as it
  // happened, and an order edited or deleted afterwards must not rewrite it.
  results Json?

  status         String  @default("running") // running | finished
  // The droplet's own batch job id, for polling GET /orders/batch/<id>.
  scraperBatchId String? @map("scraper_batch_id")
  // Set when the batch could not even be started (droplet unreachable), so a
  // finished-with-nothing-run row explains itself instead of looking empty.
  errorMessage   String? @map("error_message")

  // The batch this one is retrying, when it was started automatically for the
  // failed members of an earlier run. A batch member cannot retry in place —
  // its own batch holds the droplet's single browser lock for the whole run —
  // so the retry is a new batch, and this is what ties the two together.
  retryOfBatchId String? @map("retry_of_batch_id")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  // Exactly-once guard for the summary email — same conditional-claim rule as
  // Order.notifiedAt above.
  notifiedAt DateTime? @map("notified_at")

  @@index([userId, status])
  @@map("batch_runs")
}

// Append-only history of what a submit did, one row per stage transition and
// per outcome. The Order row only ever holds the LATEST state; answering "why
// did it fail, and did it fail the same way last time?" needs the trail.
model OrderStatusEvent {
  id      String @id @default(cuid())
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  attempt   Int      @default(1) // groups events into submit runs
  stage     String? // stage key, null for run-level events
  status    String // submitting | order_entered | submitted | warning | failed | info
  message   String? // portal text or our own explanation
  errorCode String?  @map("error_code") // oe_errors code when this event is a classified failure
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  // For the admin aggregations, which group terminal events by day across all
  // orders — a shape the index above cannot serve.
  @@index([status, createdAt])
  @@map("order_status_events")
}

// A sellable plan and the portal offer groups it requires.
//
// The portal's Offer dialog marks its mandatory groups with a red "*", and that
// dialog only exists on an order's own detail page — so an admin reads the group
// names off the portal once and records them here, rather than the system
// minting a real order per package to discover them.
model Plan {
  id          String           @id @default(cuid())
  // EXACT portal offer name — matched verbatim against the Subscription Plan
  // List, so it must not be reformatted.
  name        String           @unique
  category    String
  bandwidth   String?
  // Only published plans are sellable: unpublished means no admin has confirmed
  // its offer groups yet.
  published   Boolean          @default(false)
  // Removed by an admin on the Plan Details page. A flag rather than a DELETE:
  // the page re-seeds DEALER_OFFERS on read, so a deleted row would reappear.
  hidden      Boolean          @default(false)
  notes       String?
  offerGroups PlanOfferGroup[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([category])
  @@map("plans")
}

model PlanOfferGroup {
  id        String          @id @default(cuid())
  planId    String          @map("plan_id")
  plan      Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  // Verbatim from the dialog, pick-range included:
  //   "Unifi Home 500Mbps Premium Value With Device[Pick 0-1]"
  name      String
  // The red "*" — the group the portal REQUIRES for this plan.
  mandatory Boolean         @default(true)
  // What the group holds, set by an admin rather than guessed from the name:
  //   device   — the agent picks one (a TV, a mesh unit)
  //   channel  — an OTT bundle the portal ticks itself (Netflix, Max)
  //   discount — applied automatically during the order
  // Only device groups feed the agent's picker.
  kind      String          @default("device")
  sortOrder Int             @default(0) @map("sort_order")
  items     PlanOfferItem[]

  @@unique([planId, name])
  @@map("plan_offer_groups")
}

// A selectable row inside an offer group — a device the agent picks, or a
// discount the order carries automatically.
//
// Which of the two it is comes from the GROUP name (the portal names its
// discount groups "… Discount[Pick 0-1]"), the same rule the scraper uses to
// tell discount rows from device rows.
model PlanOfferItem {
  id        String          @id @default(cuid())
  groupId   String          @map("group_id")
  group     PlanOfferGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Verbatim from the dialog, e.g. "Premium Value Samsung TV 55inch 1 (RM20)"
  // or "Promo Discount RM10 (Perpetual) - 36 Months".
  name      String
  // The portal's numeric offer code, when known. Optional: the scraper matches
  // on code first and falls back to the name, which is unique within a group.
  code      String?
  // Rental charge in RM/month, shown to the agent. Negative for a discount.
  monthly   Float?
  // The third level. "Netflix Basic (Unifi)" is a top-level item; its tiers
  // (Basic / Standard / Premium) are children of it. Recorded for reference —
  // an order never chooses a tier, it takes the one the portal pre-ticks.
  parentId  String?         @map("parent_id")
  parent    PlanOfferItem?  @relation("ItemOptions", fields: [parentId], references: [id], onDelete: Cascade)
  options   PlanOfferItem[] @relation("ItemOptions")
  // The child the portal auto-ticks. Not inferred from monthly = 0: that would
  // be wrong the first time a bundle includes a paid tier.
  included  Boolean         @default(false)
  sortOrder Int             @default(0) @map("sort_order")

  @@unique([groupId, name])
  @@index([parentId])
  @@map("plan_offer_items")
}

// Per-user connection state for the Unifi eSales dealer portal. Tracks only the
// staff code and session lifetime — never the dealer password (Option A: we
// persist the captured session, not credentials). The actual session cookies
// live server-side with the Flask service at sessions/dealer_<userId>.json.
model DealerAccount {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  staffCode        String    @map("staff_code")
  // Email registered on the Unifi dealer account, set up by the user to
  // auto-forward OTP mail to the shared inbox — see gmail-otp-auto-read-spec.md.
  registeredEmail  String?   @map("registered_email")
  lastConnectedAt  DateTime? @map("last_connected_at")
  sessionExpiresAt DateTime? @map("session_expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dealer_accounts")
}

model CaseUsageLog {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  caseNo    String   @map("case_no") @db.VarChar(20)
  caseName  String?  @map("case_name") @db.VarChar(255)
  billType  String   @map("bill_type") @db.VarChar(20)
  chargedAt DateTime @default(now()) @map("charged_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([chargedAt])
  @@map("case_usage_log")
}

model CaseLimitChangeLog {
  id            Int      @id @default(autoincrement())
  userId        String   @map("user_id")
  previousLimit Int      @map("previous_limit")
  newLimit      Int      @map("new_limit")
  changedBy     String   @map("changed_by") @db.VarChar(100)
  reason        String?
  changedAt     DateTime @default(now()) @map("changed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("case_limit_change_log")
}

// Who did what to whom — the people audit trail. Append-only by convention AND
// by code (src/lib/audit.ts exposes record + read, nothing else). No relations
// on purpose: purging a user must not destroy the record of who purged them.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actor       String // "admin" (the one shared admin identity) or a user id
  action      String // fixed vocabulary — see src/lib/audit.ts
  targetUser  String?  @map("target_user")
  targetOrder String?  @map("target_order")
  detail      String? // one human sentence; never a secret, never JSON
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_audit_log")
}

// A pending self-service password reset. The mailed token is never stored —
// tokenHash is its SHA-256 — and usedAt makes it single-use.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model WifibizzUser {
  id                  Int            @id @default(autoincrement())
  userId              String?        @unique @map("user_id_ref")
  user                User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wifibizzEmail       String         @unique @map("wifibizz_email")
  wifibizzPasswordEnc String         @map("wifibizz_password_enc")
  googleSheetId       String?        @map("google_sheet_id")
  lastCrawlAt         DateTime?      @map("last_crawl_at")
  createdAt           DateTime?      @default(now()) @map("created_at")
  updatedAt           DateTime?      @default(now()) @map("updated_at")
  cases               WifibizzCase[]

  @@map("wifibizz_users")
}

model WifibizzCase {
  id              Int           @id @default(autoincrement())
  userId          Int?          @map("user_id")
  user            WifibizzUser? @relation(fields: [userId], references: [id])
  caseNo          String        @map("case_no")
  caseUrl         String?       @map("case_url")
  fullName        String?       @map("full_name")
  fullAddress     String?       @map("full_address")
  mobile          String?
  email           String?
  idNo            String?       @map("id_no")
  provider        String?
  package         String?
  orderNo         String?       @map("order_no")
  agent           String?
  agentRemark     String?       @map("agent_remark")
  status          String?       @default("Activated")
  internetBillUrl String?       @map("internet_bill_url")
  utilityBillUrl  String?       @map("utility_bill_url")
  caseCreatedAt   DateTime?     @map("case_created_at")
  syncedToSheetAt DateTime?     @map("synced_to_sheet_at")
  scrapedAt       DateTime?     @default(now()) @map("scraped_at")
  updatedAt       DateTime?     @default(now()) @map("updated_at")

  @@unique([userId, caseNo])
  @@index([userId, status])
  @@index([userId, caseCreatedAt(sort: Desc)])
  @@map("wifibizz_cases")
}

// Shared UMobile modem photos. Admin upload/list/delete; internet-bill
// generation picks one at random. Bytes live in R2; this row is the index.
model UmobileModemImage {
  id          String   @id @default(cuid())
  r2Key       String   @unique @map("r2_key")
  filename    String
  contentType String   @map("content_type")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("umobile_modem_images")
}
